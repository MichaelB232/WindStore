NODE_ENV=development                       # set to "production" when deployed
DATABASE_URL="yourdburl"
JWT_SECRET="your-secret-code"
PORT="8000"
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxx    # from Midtrans dashboard
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxx    # from Midtrans dashboard
MIDTRANS_IS_PRODUCTION=false               # true in production
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=your-secret
CLIENT_URL=http://localhost:3000           # set to your Vercel URL in production
